{
  "name": "product-continuity",
  "version": "0.2.0",
  "private": true,
  "description": "Local product continuity skill: versioned project state, intent review contract, static map and change receipts.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:distribution": "node --test tests/distribution.test.mjs",
    "validate:schema": "node scripts/validate-schema-runner.mjs",
    "dist:build": "node scripts/build-dist.mjs",
    "dist:check": "node scripts/build-dist.mjs --check"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
